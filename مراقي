<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>دورة مَراقي التجويد | ارتقاءٌ في العلم، وإتقانٌ في التلاوة</title>
<meta name="description" content="دورة مَراقي التجويد: دورة تعليمية مكثّفة في أحكام التجويد، عبر ثلاث مراقٍ متدرّجة، بصحبة معلمة مُجازة.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&family=Tajawal:wght@300;400;500;700;800&family=Amiri:ital@0;1&display=swap" rel="stylesheet">
<style>
/* ============================================================
   دورة مَراقي التجويد — ملف تصميم الموقع
   يمكن تعديل الألوان والنصوص من داخل هذا الملف مباشرة
   ============================================================ */

:root{
  --cream:        #EFE8D6;
  --cream-light:  #F8F4E9;
  --cream-deep:   #E3DABF;
  --ink:          #232A18;
  --ink-soft:     #4B5540;
  --green-deep:   #3B4A2C;
  --green-mid:    #5B6B45;
  --green-dark:   #1C2314;
  --green-line:   #2E3620;
  --gold:         #A9793F;
  --gold-light:   #C9A46B;
  --gold-pale:    #E8D5B0;
  --serif: 'Amiri', serif;
  --display: 'Cairo', sans-serif;
  --body: 'Tajawal', sans-serif;
  --radius: 18px;
  --shadow: 0 20px 45px -20px rgba(28,35,20,.35);
}

*{ box-sizing:border-box; margin:0; padding:0; }
html{ scroll-behavior:smooth; }
body{
  font-family: var(--body);
  background: var(--cream);
  color: var(--ink);
  line-height:1.85;
  overflow-x:hidden;
}
img{ max-width:100%; display:block; }
a{ color:inherit; text-decoration:none; }
ul{ list-style:none; }
section{ position:relative; }
.container{
  max-width:1160px;
  margin:0 auto;
  padding:0 28px;
}
h1,h2,h3,h4{
  font-family: var(--display);
  font-weight:800;
  color: var(--green-deep);
  line-height:1.35;
}
.eyebrow{
  display:inline-flex;
  align-items:center;
  gap:10px;
  font-family: var(--display);
  font-weight:700;
  font-size:.8rem;
  letter-spacing:.5px;
  color: var(--gold);
  background: rgba(169,121,63,.1);
  border:1px solid rgba(169,121,63,.35);
  padding:7px 18px;
  border-radius:99px;
  margin-bottom:18px;
}
.eyebrow::before{
  content:"";
  width:6px; height:6px;
  border-radius:50%;
  background: var(--gold);
}
.section-head{
  text-align:center;
  max-width:700px;
  margin:0 auto 56px;
}
.section-head h2{
  font-size: clamp(1.9rem, 4vw, 2.7rem);
  margin-bottom:16px;
}
.section-head p{
  color: var(--ink-soft);
  font-size:1.05rem;
}
.btn{
  display:inline-flex;
  align-items:center;
  gap:10px;
  font-family: var(--display);
  font-weight:700;
  font-size:1rem;
  padding:16px 34px;
  border-radius:99px;
  cursor:pointer;
  border:none;
  transition: transform .35s cubic-bezier(.2,.8,.2,1), box-shadow .35s;
}
.btn-gold{
  background: linear-gradient(135deg, var(--gold-light), var(--gold));
  color: var(--cream-light);
  box-shadow: 0 14px 30px -10px rgba(169,121,63,.55);
}
.btn-gold:hover{ transform: translateY(-3px); box-shadow: 0 20px 38px -12px rgba(169,121,63,.65); }
.btn-outline{
  background: transparent;
  color: var(--green-deep);
  border:1.5px solid var(--green-deep);
}
.btn-outline:hover{ background: var(--green-deep); color: var(--cream-light); }
.btn-outline-light{
  background: transparent;
  color: var(--cream-light);
  border:1.5px solid rgba(248,244,233,.5);
}
.btn-outline-light:hover{ background: rgba(248,244,233,.12); border-color: var(--cream-light); }

/* ============ زخرفة هندسية إسلامية (SVG مولّد) ============ */
.geo-pattern{
  position:absolute; inset:0;
  background-image:
    linear-gradient(45deg, transparent 48%, currentColor 48%, currentColor 52%, transparent 52%),
    linear-gradient(-45deg, transparent 48%, currentColor 48%, currentColor 52%, transparent 52%);
  background-size:64px 64px;
  opacity:.05;
  pointer-events:none;
}

/* ============ الهيدر ============ */
.site-header{
  position:fixed; top:0; right:0; left:0; z-index:100;
  padding:14px 0;
  background: rgba(239,232,214,.75);
  backdrop-filter: blur(14px) saturate(140%);
  border-bottom:1px solid rgba(59,74,44,.08);
  transition: padding .3s ease, box-shadow .3s ease;
}
.site-header.scrolled{ padding:8px 0; box-shadow: 0 8px 24px -18px rgba(28,35,20,.5); }
.site-header .container{ display:flex; align-items:center; justify-content:space-between; gap:20px; }
.brand{ display:flex; align-items:center; gap:12px; }
.brand img{ width:46px; height:46px; border-radius:50%; }
.brand-text{ font-family: var(--display); }
.brand-text b{ display:block; font-weight:800; color: var(--green-deep); font-size:1.05rem; }
.brand-text span{ display:block; font-size:.72rem; color: var(--gold); font-weight:600; }
.nav-links{ display:flex; align-items:center; gap:30px; font-family: var(--display); font-weight:600; font-size:.92rem; }
.nav-links a{ position:relative; color: var(--ink); padding:4px 0; }
.nav-links a::after{
  content:""; position:absolute; right:0; bottom:-4px; width:0; height:2px;
  background: var(--gold); transition: width .3s;
}
.nav-links a:hover::after{ width:100%; }
.nav-cta{ display:flex; align-items:center; gap:14px; }
.nav-cta .btn{ padding:11px 24px; font-size:.88rem; }
.menu-toggle{ display:none; flex-direction:column; gap:5px; background:none; border:none; cursor:pointer; padding:8px; }
.menu-toggle span{ width:24px; height:2px; background: var(--green-deep); border-radius:2px; }

/* ============ الهيرو ============ */
.hero{
  position:relative;
  padding:170px 0 110px;
  background:
    radial-gradient(ellipse at 85% -10%, rgba(169,121,63,.16), transparent 55%),
    radial-gradient(ellipse at -10% 110%, rgba(91,107,69,.18), transparent 55%),
    var(--cream);
  overflow:hidden;
}
.hero .container{
  display:grid;
  grid-template-columns: 1.05fr .95fr;
  gap:60px;
  align-items:center;
}
.hero-kicker{
  font-family: var(--serif);
  font-style:italic;
  color: var(--gold);
  font-size:1.15rem;
  margin-bottom:18px;
  display:block;
}
.hero h1{
  font-size: clamp(2.6rem, 5.4vw, 4.1rem);
  margin-bottom:10px;
}
.hero h1 em{
  font-style:normal;
  color: var(--gold);
  position:relative;
}
.hero .tagline{
  font-family: var(--display);
  font-weight:700;
  color: var(--green-mid);
  font-size:1.25rem;
  margin:14px 0 26px;
}
.hero p.desc{
  color: var(--ink-soft);
  font-size:1.05rem;
  max-width:540px;
  margin-bottom:36px;
}
.hero-actions{ display:flex; gap:16px; flex-wrap:wrap; margin-bottom:44px; }
.hero-stats{
  display:flex; gap:0; border-top:1px solid rgba(59,74,44,.15); padding-top:26px;
}
.hero-stats div{ flex:1; padding-left:22px; }
.hero-stats div + div{ border-right:1px solid rgba(59,74,44,.15); padding-right:22px; }
.hero-stats b{ display:block; font-family: var(--display); font-size:1.6rem; color: var(--green-deep); }
.hero-stats span{ font-size:.82rem; color: var(--ink-soft); }

.hero-visual{ position:relative; }
.hero-visual .frame{
  position:relative;
  border-radius: 28px;
  overflow:hidden;
  box-shadow: var(--shadow);
  border:10px solid var(--cream-light);
}
.hero-visual .frame img{ width:100%; height:520px; object-fit:cover; object-position:center 30%; }
.hero-visual .badge{
  position:absolute;
  bottom:-26px; right:-18px;
  background: var(--green-deep);
  color: var(--cream-light);
  padding:20px 26px;
  border-radius:20px;
  box-shadow: var(--shadow);
  display:flex; align-items:center; gap:14px;
  max-width:230px;
}
.hero-visual .badge .icon{ font-size:1.7rem; }
.hero-visual .badge b{ display:block; font-family: var(--display); font-size:.95rem; }
.hero-visual .badge span{ font-size:.78rem; opacity:.8; }
.hero-visual .ring{
  position:absolute; top:-30px; left:-30px;
  width:120px; height:120px;
  border:1.5px solid var(--gold-light);
  border-radius:50%;
  z-index:-1;
}

/* ============ شريط آية ============ */
.ayah-strip{
  background: var(--green-deep);
  color: var(--cream-light);
  padding:26px 0;
  text-align:center;
  position:relative;
  overflow:hidden;
}
.ayah-strip p{
  font-family: var(--serif);
  font-size:1.3rem;
  position:relative; z-index:2;
  letter-spacing:.3px;
}
.ayah-strip span{
  display:block;
  font-family: var(--body);
  font-size:.78rem;
  color: var(--gold-light);
  margin-top:8px;
  letter-spacing:.5px;
}

/* ============ مميزات الدورة ============ */
.features{ padding:110px 0; background: var(--cream); }
.features-grid{
  display:grid;
  grid-template-columns: repeat(3, 1fr);
  gap:26px;
}
.feature-card{
  background: var(--cream-light);
  border:1px solid rgba(59,74,44,.1);
  border-radius: var(--radius);
  padding:36px 30px;
  transition: transform .4s cubic-bezier(.2,.8,.2,1), box-shadow .4s;
  position:relative;
}
.feature-card:hover{ transform: translateY(-8px); box-shadow: var(--shadow); }
.feature-card .num{
  font-family: var(--display); font-weight:900;
  font-size:2.6rem;
  color: var(--gold-pale);
  -webkit-text-stroke: 1.5px var(--gold);
  color:transparent;
  margin-bottom:14px;
  display:block;
}
.feature-card h3{ font-size:1.1rem; margin-bottom:10px; }
.feature-card p{ color: var(--ink-soft); font-size:.92rem; }
.feature-thumb{
  width:100%; height:84px; object-fit:cover;
  border-radius:12px; margin-bottom:14px;
  border:1px solid rgba(59,74,44,.12);
}

.info-strip{
  margin-top:56px;
  background: var(--green-deep);
  border-radius: 24px;
  padding:44px 46px;
  display:grid;
  grid-template-columns: repeat(4, 1fr);
  gap:30px;
  color: var(--cream-light);
  position:relative;
  overflow:hidden;
}
.info-strip::before{
  content:"";
  position:absolute; inset:0;
  background: radial-gradient(circle at 90% 10%, rgba(201,164,107,.18), transparent 60%);
}
.info-item{ position:relative; z-index:1; text-align:center; }
.info-item .ic{ font-size:1.6rem; margin-bottom:10px; display:block; }
.info-item b{ display:block; font-family: var(--display); font-size:.98rem; margin-bottom:4px; }
.info-item span{ font-size:.8rem; opacity:.75; }

/* ============ خطة مراقي التجويد (السلّم) ============ */
.plan-section{
  padding:120px 0 100px;
  background:
    linear-gradient(180deg, var(--cream) 0%, var(--cream-deep) 100%);
  position:relative;
}
.staircase{
  display:grid;
  grid-template-columns: repeat(3, 1fr);
  gap:18px;
  margin-bottom:60px;
}
.stair-step{
  cursor:pointer;
  border:none;
  font-family:inherit;
  text-align:center;
  color: var(--cream-light);
  padding:34px 22px;
  position:relative;
  display:block;
  border-radius:20px;
  transition: transform .35s cubic-bezier(.2,.8,.2,1), filter .35s;
  text-decoration:none;
}
.stair-step:nth-child(1){ background: var(--green-mid); }
.stair-step:nth-child(2){ background: var(--green-deep); }
.stair-step:nth-child(3){ background: var(--green-dark); }
.stair-step:hover, .stair-step.active{ filter:brightness(1.12); transform: translateY(-6px); }
.stair-step .mrq-label{
  font-family: var(--serif); font-style:italic; color: var(--gold-light);
  font-size:.95rem; display:block; margin-bottom:8px;
}
.stair-step h3{ color: var(--cream-light); font-size:1.35rem; margin-bottom:10px; }
.stair-step p{ font-size:.82rem; opacity:.8; max-width:220px; margin:0 auto; }
.stair-step .arrow{
  margin:16px auto 0;
  width:30px; height:30px; border-radius:50%;
  border:1.5px solid rgba(248,244,233,.4);
  display:flex; align-items:center; justify-content:center;
  font-size:1rem;
  transition: background .3s, transform .3s;
}
.stair-step.active .arrow{ background: var(--gold); border-color: var(--gold); transform: rotate(45deg); }

.plan-detail{
  background: var(--cream-light);
  border-radius: 24px;
  box-shadow: var(--shadow);
  padding:40px 46px;
  margin-bottom:26px;
  scroll-margin-top:110px;
  display:none;
  animation: fadeUp .45s ease;
}
.plan-detail.active{ display:block; }
@keyframes fadeUp{ from{ opacity:0; transform:translateY(14px);} to{opacity:1; transform:translateY(0);} }
.plan-detail-head{
  display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:18px;
  margin-bottom:30px; padding-bottom:24px; border-bottom:1px dashed rgba(59,74,44,.25);
}
.plan-detail-head h3{ font-size:1.6rem; display:flex; align-items:center; gap:14px; }
.mrq-num{
  display:inline-flex; align-items:center; justify-content:center;
  width:38px; height:38px; border-radius:50%;
  background: var(--gold); color:#fff;
  font-family: var(--display); font-size:1.05rem;
  flex-shrink:0;
}
.plan-detail-head .topics{ display:flex; gap:10px; flex-wrap:wrap; }
.plan-detail-head .topics span{
  font-size:.78rem; font-weight:700; font-family: var(--display);
  background: rgba(91,107,69,.12); color: var(--green-mid);
  padding:6px 14px; border-radius:99px;
}
.days-grid{
  display:grid;
  grid-template-columns: repeat(auto-fit, minmax(210px,1fr));
  gap:14px;
}
.day-card{
  background: var(--cream);
  border-radius:14px;
  padding:18px 20px;
  border-inline-start:3px solid var(--gold);
}
.day-card.rest{ border-inline-start-color: var(--green-mid); opacity:.75; }
.day-card.test{ border-inline-start-color: var(--green-deep); background: rgba(59,74,44,.06); }
.day-card b{ font-family: var(--display); font-size:.85rem; color: var(--gold); display:block; margin-bottom:6px; }
.day-card.rest b, .day-card.test b{ color: var(--green-deep); }
.day-card p{ font-size:.9rem; color: var(--ink); }

/* ============ آراء المشاركات ============ */
.testimonials{ padding:110px 0; background: var(--green-dark); color: var(--cream-light); position:relative; overflow:hidden; }
.testimonials::before{
  content:"﴾"; position:absolute; font-family: var(--serif); font-size:24rem; color: rgba(201,164,107,.05);
  top:-100px; right:-40px; line-height:1;
}
.testimonials .section-head h2{ color: var(--cream-light); }
.testimonials .section-head p{ color: rgba(248,244,233,.65); }
.t-carousel{ position:relative; }
.t-track-wrap{
  overflow-x:auto;
  overflow-y:hidden;
  scroll-snap-type: x mandatory;
  scroll-behavior:smooth;
  padding:6px 4px 20px;
  -ms-overflow-style:none;
  scrollbar-width:none;
}
.t-track-wrap::-webkit-scrollbar{ display:none; }
.t-track{
  display:flex; gap:22px; width:max-content;
}
.t-card{
  width:340px; flex:0 0 auto;
  scroll-snap-align:start;
  background: rgba(248,244,233,.06);
  border:1px solid rgba(248,244,233,.12);
  border-radius:18px;
  padding:28px 26px;
  cursor:grab;
  max-height:340px;
  overflow-y:auto;
}
.t-card:active{ cursor:grabbing; }
.t-card .quote-mark{ font-family: var(--serif); font-size:2.2rem; color: var(--gold-light); line-height:1; margin-bottom:10px; display:block; }
.t-card p{ font-size:.9rem; line-height:1.75; color: rgba(248,244,233,.88); margin-bottom:16px; }
.t-card .who{ display:flex; align-items:center; gap:10px; font-family: var(--display); font-size:.82rem; color: var(--gold-light); }
.t-card .who .dot{ width:7px; height:7px; border-radius:50%; background: var(--gold); }
.t-controls{ display:flex; align-items:center; justify-content:center; gap:22px; margin-top:14px; }
.t-arrow{
  width:48px; height:48px; border-radius:50%;
  background: rgba(248,244,233,.08);
  border:1px solid rgba(248,244,233,.2);
  color: var(--cream-light);
  display:flex; align-items:center; justify-content:center;
  font-size:1.1rem; cursor:pointer;
  transition: background .3s, transform .3s;
  flex-shrink:0;
}
.t-arrow:hover{ background: var(--gold); border-color: var(--gold); transform:scale(1.06); }
.t-dots{ display:flex; gap:9px; }
.t-dots button{
  width:9px; height:9px; border-radius:50%; border:none;
  background: rgba(248,244,233,.25); cursor:pointer; padding:0;
  transition: background .3s, transform .3s;
}
.t-dots button.active{ background: var(--gold); transform:scale(1.25); }

/* ============ عن المعلمة ============ */
.teacher{ padding:110px 0; background: var(--cream); }
.teacher .teacher-main{ display:grid; grid-template-columns: .85fr 1.15fr; gap:60px; align-items:center; }
.teacher-visual{
  position:relative;
  background: linear-gradient(155deg, var(--green-deep), var(--green-dark));
  border-radius: 28px;
  padding:56px 34px;
  text-align:center;
  color: var(--cream-light);
  box-shadow: var(--shadow);
}
.teacher-visual .emblem{
  width:96px; height:96px; margin:0 auto 22px;
  border-radius:50%;
  border:1.5px solid var(--gold-light);
  display:flex; align-items:center; justify-content:center;
  font-size:2.2rem;
}
.teacher-visual h3{ color: var(--cream-light); font-size:1.4rem; margin-bottom:6px; }
.teacher-visual span.role{ display:block; color: var(--gold-light); font-size:.88rem; margin-bottom:26px; font-family: var(--display); font-weight:600; }
.teacher-visual .ijazah-list{ text-align:right; border-top:1px solid rgba(248,244,233,.15); padding-top:22px; }
.teacher-visual .ijazah-list li{ display:flex; gap:10px; font-size:.85rem; margin-bottom:14px; color: rgba(248,244,233,.85); }
.teacher-visual .ijazah-list li::before{ content:"◆"; color: var(--gold); font-size:.6rem; margin-top:6px; }
.teacher-text h2{ font-size: clamp(1.8rem,3.6vw,2.4rem); margin-bottom:20px; }
.teacher-text p{ color: var(--ink-soft); margin-bottom:18px; font-size:1.02rem; }

/* ============ الفيديوهات ============ */
.media-section{ padding:110px 0; background: var(--cream-deep); }
.media-grid{
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap:20px;
  max-width:560px;
  margin:0 auto;
}
.media-card{
  display:block;
  background: var(--green-dark);
  border-radius:18px;
  overflow:hidden;
  box-shadow: var(--shadow);
  position:relative;
  transition: transform .4s cubic-bezier(.2,.8,.2,1);
}
.media-card:hover{ transform: translateY(-6px); }
.media-card .video-wrap{ position:relative; width:100%; padding-top:66%; background:#111; overflow:hidden; }
.media-card .yt-thumb{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:.85; transition: opacity .35s, transform .5s; }
.media-card:hover .yt-thumb{ opacity:1; transform: scale(1.04); }
.media-card .play-btn{
  position:absolute; top:50%; right:50%; transform:translate(50%,-50%);
  width:42px; height:42px; border-radius:50%;
  background: rgba(169,121,63,.9);
  color:#fff; display:flex; align-items:center; justify-content:center;
  font-size:.9rem; padding-right:3px;
  box-shadow: 0 8px 18px -5px rgba(0,0,0,.6);
  transition: background .3s, transform .3s;
}
.media-card:hover .play-btn{ background: var(--gold); transform: translate(50%,-50%) scale(1.08); }
.media-card .cap{ padding:14px 16px; color: var(--cream-light); }
.media-card .cap b{ font-family: var(--display); display:block; margin-bottom:2px; font-size:.85rem; }
.media-card .cap span{ font-size:.72rem; color: var(--gold-light); }

/* ============ التسجيل ============ */
.register{
  padding:120px 0;
  background: var(--green-deep);
  color: var(--cream-light);
  text-align:center;
  position:relative;
  overflow:hidden;
}
.register::before, .register::after{
  content:""; position:absolute; width:420px; height:420px; border-radius:50%;
  border:1px solid rgba(201,164,107,.15);
}
.register::before{ top:-220px; right:-160px; }
.register::after{ bottom:-260px; left:-180px; }
.register-inner{ position:relative; z-index:2; max-width:640px; margin:0 auto; }
.register .eyebrow{ background: rgba(201,164,107,.12); }
.register h2{ color: var(--cream-light); font-size: clamp(2rem,4.6vw,3rem); margin-bottom:18px; }
.register p{ color: rgba(248,244,233,.75); margin-bottom:38px; font-size:1.05rem; }
.register-tiers{ display:flex; gap:16px; justify-content:center; margin-bottom:40px; flex-wrap:wrap; }
.tier{
  background: rgba(248,244,233,.06);
  border:1px solid rgba(248,244,233,.15);
  border-radius:16px;
  padding:20px 26px;
  min-width:150px;
}
.tier b{ display:block; font-family: var(--display); font-size:1.3rem; color: var(--gold-light); margin-bottom:4px; }
.tier span{ font-size:.8rem; opacity:.75; }
.register .btn-gold{ font-size:1.05rem; padding:19px 46px; }
.register .note{ margin-top:20px; font-size:.82rem; opacity:.6; }

/* ============ الفوتر ============ */
footer{ background: var(--green-dark); color: rgba(248,244,233,.75); padding:70px 0 26px; }
.footer-grid{
  display:grid;
  grid-template-columns: 1.3fr 1fr 1fr;
  gap:50px;
  padding-bottom:46px;
  border-bottom:1px solid rgba(248,244,233,.1);
}
.footer-brand{ display:flex; gap:14px; align-items:flex-start; }
.footer-brand img{ width:52px; height:52px; border-radius:50%; flex-shrink:0; }
.footer-brand h4{ color: var(--cream-light); font-family: var(--display); margin-bottom:8px; }
.footer-brand p{ font-size:.88rem; line-height:1.9; opacity:.8; max-width:320px; }
.footer-col h5{ color: var(--gold-light); font-family: var(--display); font-size:.95rem; margin-bottom:18px; }
.footer-col a, .footer-col p{ display:block; font-size:.9rem; margin-bottom:12px; opacity:.85; transition: opacity .25s, color .25s; }
.footer-col a:hover{ opacity:1; color: var(--gold-light); }
.contact-row{ display:flex; align-items:center; gap:10px; }
.contact-row .ic{
  width:34px; height:34px; border-radius:50%;
  background: rgba(248,244,233,.08);
  display:flex; align-items:center; justify-content:center; flex-shrink:0;
}
.footer-bottom{
  padding-top:26px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;
  font-size:.8rem; opacity:.6;
}

/* ============ سكرول ريفيل ============ */
.reveal{ opacity:0; transform:translateY(28px); transition: opacity .8s cubic-bezier(.2,.8,.2,1), transform .8s cubic-bezier(.2,.8,.2,1); }
.reveal.in{ opacity:1; transform:translateY(0); }

/* ============ زر عائم للواتساب ============ */
.float-wa{
  position:fixed; bottom:26px; left:26px; z-index:90;
  width:58px; height:58px; border-radius:50%;
  background: var(--green-deep);
  color: var(--cream-light);
  display:flex; align-items:center; justify-content:center;
  font-size:1.5rem;
  box-shadow: 0 14px 30px -10px rgba(28,35,20,.5);
  transition: transform .3s;
}
.float-wa:hover{ transform: scale(1.08); }

/* ============ استجابة الجوال ============ */
@media (max-width:980px){
  .nav-links{ display:none; }
  .menu-toggle{ display:flex; }
  .hero .container{ grid-template-columns:1fr; }
  .hero{ padding:150px 0 80px; text-align:center; }
  .hero p.desc{ margin-inline:auto; }
  .hero-stats{ justify-content:center; }
  .hero-visual{ order:-1; }
  .features-grid{ grid-template-columns:1fr; }
  .info-strip{ grid-template-columns: repeat(2,1fr); }
  .staircase{ grid-template-columns:1fr; }
  .plan-detail{ padding:30px 24px; }
  .teacher .teacher-main{ grid-template-columns:1fr; }
  .media-grid{ max-width:340px; gap:14px; }
  .footer-grid{ grid-template-columns:1fr; gap:36px; }
}
